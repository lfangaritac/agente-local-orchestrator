{"type":"tool_use","timestamp":1778273047443,"sessionID":"ses_1f6aaf541fferTWE0bTeOncBHX","part":{"type":"tool","tool":"read","callID":"read:4","state":{"status":"completed","input":{"filePath":"C:\\Agente\\mcp_server\\test_mcp_stdio.py"},"output":"<path>C:\\Agente\\mcp_server\\test_mcp_stdio.py</path>\n<type>file</type>\n<content>\n1: ﻿\"\"\"\n2: test_mcp_stdio.py\n3: \n4: Prueba local del servidor MCP por stdio usando JSON-RPC.\n5: \n6: Valida:\n7: - initialize\n8: - tools/list\n9: - tools/call orchestrator_preflight\n10: - tools/call select_agent_model\n11: - tools/call run_diagnostic_flow sin OpenCode\n12: \n13: No conecta Continue todavía.\n14: No ejecuta comandos arbitrarios.\n15: \"\"\"\n16: \n17: from __future__ import annotations\n18: \n19: from pathlib import Path\n20: import json\n21: import subprocess\n22: import sys\n23: import threading\n24: import time\n25: \n26: \n27: ROOT = Path(__file__).resolve().parents[1]\n28: SERVER = ROOT / \"mcp_server\" / \"server.py\"\n29: \n30: \n31: def reader_thread(pipe, lines: list[str]) -> None:\n32:     for line in iter(pipe.readline, \"\"):\n33:         if not line:\n34:             break\n35:         lines.append(line.rstrip(\"\\n\"))\n36: \n37: \n38: def send(proc: subprocess.Popen, payload: dict) -> None:\n39:     raw = json.dumps(payload, ensure_ascii=False)\n40:     proc.stdin.write(raw + \"\\n\")\n41:     proc.stdin.flush()\n42: \n43: \n44: def parse_responses(lines: list[str]) -> list[dict]:\n45:     parsed = []\n46:     for line in lines:\n47:         try:\n48:             parsed.append(json.loads(line))\n49:         except Exception:\n50:             parsed.append({\"raw\": line})\n51:     return parsed\n52: \n53: \n54: def main() -> None:\n55:     proc = subprocess.Popen(\n56:         [sys.executable, str(SERVER)],\n57:         cwd=ROOT,\n58:         stdin=subprocess.PIPE,\n59:         stdout=subprocess.PIPE,\n60:         stderr=subprocess.PIPE,\n61:         text=True,\n62:         encoding=\"utf-8\",\n63:         errors=\"replace\",\n64:     )\n65: \n66:     stdout_lines: list[str] = []\n67:     stderr_lines: list[str] = []\n68: \n69:     t_out = threading.Thread(target=reader_thread, args=(proc.stdout, stdout_lines), daemon=True)\n70:     t_err = threading.Thread(target=reader_thread, args=(proc.stderr, stderr_lines), daemon=True)\n71:     t_out.start()\n72:     t_err.start()\n73: \n74:     messages = [\n75:         {\n76:             \"jsonrpc\": \"2.0\",\n77:             \"id\": 1,\n78:             \"method\": \"initialize\",\n79:             \"params\": {\n80:                 \"protocolVersion\": \"2024-11-05\",\n81:                 \"capabilities\": {},\n82:                 \"clientInfo\": {\n83:                     \"name\": \"local-mcp-test\",\n84:                     \"version\": \"0.1.0\"\n85:                 }\n86:             }\n87:         },\n88:         {\n89:             \"jsonrpc\": \"2.0\",\n90:             \"method\": \"notifications/initialized\",\n91:             \"params\": {}\n92:         },\n93:         {\n94:             \"jsonrpc\": \"2.0\",\n95:             \"id\": 2,\n96:             \"method\": \"tools/list\",\n97:             \"params\": {}\n98:         },\n99:         {\n100:             \"jsonrpc\": \"2.0\",\n101:             \"id\": 3,\n102:             \"method\": \"tools/call\",\n103:             \"params\": {\n104:                 \"name\": \"orchestrator_preflight\",\n105:                 \"arguments\": {}\n106:             }\n107:         },\n108:         {\n109:             \"jsonrpc\": \"2.0\",\n110:             \"id\": 4,\n111:             \"method\": \"tools/call\",\n112:             \"params\": {\n113:                 \"name\": \"select_agent_model\",\n114:                 \"arguments\": {\n115:                     \"scenario\": \"context-validation\",\n116:                     \"risk\": \"medium\",\n117:                     \"volume\": \"high\"\n118:                 }\n119:             }\n120:         },\n121:         {\n122:             \"jsonrpc\": \"2.0\",\n123:             \"id\": 5,\n124:             \"method\": \"tools/call\",\n125:             \"params\": {\n126:                 \"name\": \"run_diagnostic_flow\",\n127:                 \"arguments\": {\n128:                     \"project_id\": \"orchestrator\",\n129:                     \"scenario\": \"context-validation\",\n130:                     \"risk\": \"medium\",\n131:                     \"volume\": \"high\",\n132:                     \"objective\": \"Prueba MCP stdio v0.1 sin OpenCode.\",\n133:                     \"with_opencode\": False\n134:                 }\n135:             }\n136:         }\n137:     ]\n138: \n139:     for msg in messages:\n140:         send(proc, msg)\n141:         time.sleep(0.4)\n142: \n143:     time.sleep(2.0)\n144: \n145:     proc.terminate()\n146:     try:\n147:         proc.wait(timeout=5)\n148:     except subprocess.TimeoutExpired:\n149:         proc.kill()\n150: \n151:     responses = parse_responses(stdout_lines)\n152: \n153:     result = {\n154:         \"stdout_response_count\": len(responses),\n155:         \"stderr_lines\": stderr_lines,\n156:         \"responses\": responses,\n157:         \"checks\": {\n158:             \"initialize_ok\": any(r.get(\"id\") == 1 and \"result\" in r for r in responses),\n159:             \"tools_list_ok\": any(r.get(\"id\") == 2 and \"result\" in r for r in responses),\n160:             \"preflight_call_ok\": any(r.get(\"id\") == 3 and \"result\" in r for r in responses),\n161:             \"select_agent_model_ok\": any(r.get(\"id\") == 4 and \"result\" in r for r in responses),\n162:             \"run_diagnostic_flow_ok\": any(r.get(\"id\") == 5 and \"result\" in r for r in responses),\n163:         }\n164:     }\n165: \n166:     print(json.dumps(result, ensure_ascii=True, indent=2))\n167: \n168:     failed = [name for name, ok in result[\"checks\"].items() if not ok]\n169:     if failed:\n170:         print(\"FAILED_CHECKS:\", \", \".join(failed)