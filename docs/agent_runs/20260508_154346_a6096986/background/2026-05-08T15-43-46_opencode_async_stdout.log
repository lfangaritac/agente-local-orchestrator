        \"unauthorized_run_id\": unauthorized_run_id,\n240:         \"authorized_run_id\": authorized_run_id,\n241:         \"unauthorized_files_ok\": unauthorized_files_ok,\n242:         \"authorized_files_ok\": authorized_files_ok,\n243:         \"unauthorized_next_tool\": call_unauthorized_result.get(\"next_tool\") if call_unauthorized_result else None,\n244:         \"authorized_next_tool\": call_authorized_result.get(\"next_tool\") if call_authorized_result else None,\n245:         \"stdout_lines_count\": len(stdout_lines),\n246:         \"stderr_lines\": stderr_lines,\n247:         \"server_returncode\": proc.returncode,\n248:     }\n249: \n250:     print(json.dumps(result, ensure_ascii=True, indent=2))\n251: \n252:     failed = [\n253:         name for name, ok in {\n254:             \"initialize_ok\": result[\"initialize_ok\"],\n255:             \"tools_list_ok\": result[\"tools_list_ok\"],\n256:             \"call_unauthorized_ok\": result[\"call_unauthorized_ok\"],\n257:             \"call_authorized_ok\": result[\"call_authorized_ok\"],\n258:             \"unauthorized_waiting\": result[\"unauthorized_status\"] == \"waiting_authorization\",\n259:             \"authorized_dispatched\": result[\"authorized_status\"] == \"dispatched\",\n260:             \"unauthorized_files_ok\": result[\"unauthorized_files_ok\"],\n261:             \"authorized_files_ok\": result[\"authorized_files_ok\"],\n262:             \"unauthorized_next_tool\": result[\"unauthorized_next_tool\"] == \"check_opencode_run_status\",\n263:             \"authorized_next_tool\": result[\"authorized_next_tool\"] == \"check_opencode_run_status\",\n264:         }.items()\n265:         if not ok\n266:     ]\n267: \n268:     if failed:\n269:         print(\"FAILED_CHECKS:\", \", \".join(failed))\n270:         sys.exit(1)\n271: \n272: \n273: if __name__ == \"__main__\":\n274:     main()\n\n(End of file - total 274 lines)\n</content>","metadata":{"preview":"\"\"\"\ntest_create_and_dispatch_opencode_