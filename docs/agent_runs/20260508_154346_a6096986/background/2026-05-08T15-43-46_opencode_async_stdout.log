ensaje. \"\n49:             f\"returncode={proc.returncode}. stderr={stderr_lines}\"\n50:         )\n51: \n52:     raw = json.dumps(payload, ensure_ascii=False)\n53: \n54:     try:\n55:         proc.stdin.write(raw + \"\\n\")\n56:         proc.stdin.flush()\n57:     except OSError as exc:\n58:         raise RuntimeError(\n59:             \"No se pudo escribir en stdin del servidor MCP. \"\n60:             f\"returncode={proc.poll()}. stderr={stderr_lines}\"\n61:         ) from exc\n62: \n63: \n64: def parse_responses(stdout_lines: list[str]) -> list[dict]:\n65:     responses: list[dict] = []\n66:     for line in stdout_lines:\n67:         try:\n68:             responses.append(json.loads(line))\n69:         except Exception:\n70:             responses.append({\"raw\": line})\n71:     return responses\n72: \n73: \n74: def extract_tool_result(response: dict | None) -> dict | None:\n75:     if not response:\n76:         return None\n77:     content = response.get(\"result\", {}).get(\"content\", [])\n78:     if not content:\n79:         return None\n80:     text = content[0].get(\"text\", \"\")\n81:     try:\n82:         outer = json.loads(text)\n83:         parsed = outer.get(\"parsed\")\n84:         if isinstance(parsed, dict):\n85:             return parsed\n86:         return outer\n87:     except Exception:\n88:         return None\n89: \n90: \n91: def main() -> None:\n92:     proc = subprocess.Popen(\n93:         [sys.executable, str(SERVER)],\n94:         cwd=ROOT,\n95:         stdin=subprocess.PIPE,\n96:         stdout=subprocess.PIPE,\n97:         stderr=subprocess.PIPE,\n98:         text=True,\n99:         encoding=\"utf-8\",\n100:         errors=\"replace\",\n101:     )\n102: \n103:     stdout_lines: list[str] = []\n104:     stderr_lines: list[str] = []\n105: \n106:     t_out = threading.Thread(target=reader_thread, args=(proc.stdout, stdout_lines), daemon=True)\n107:     t_err = threading.Thread(target=reader_thread, args=(proc.stderr, stderr_lines), daemon