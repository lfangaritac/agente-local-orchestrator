parse_args()\n42: \n43:     requires_auth = args.requires_authorization.lower() == \"true\"\n44:     auth_granted = args.authorization_granted.lower() == \"true\"\n45: \n46:     run_id = datetime.datetime.now().strftime(\"%Y%m%d_%H%M%S\") + \"_\" + os.urandom(4).hex()\n47: \n48:     QUEUE_INBOX.mkdir(parents=True, exist_ok=True)\n49:     RUNS.mkdir(parents=True, exist_ok=True)\n50: \n51:     run_dir = RUNS / run_id\n52:     run_dir.mkdir(parents=True, exist_ok=True)\n53: \n54:     package = {\n55:         \"run_id\": run_id,\n56:         \"project_id\": args.project_id,\n57:         \"objective\": args.objective,\n58:         \"handoff_body\": args.handoff_body,\n59:         \"target_agent\": args.target_agent,\n60:         \"model\": args.model,\n61:         \"risk_level\": args.risk_level,\n62:         \"scenario\": args.scenario,\n63:         \"allowed_files\": args.allowed_files,\n64:         \"validation_commands\": args.validation_commands,\n65:         \"requires_authorization\": requires_auth,\n66:         \"authorization_granted\": auth_granted,\n67:         \"status\": \"created\",\n68:         \"timestamp\": datetime.datetime.now().isoformat(timespec=\"seconds\"),\n69:     }\n70: \n71:     json_path = QUEUE_INBOX / f\"{run_id}.json\"\n72:     md_path = QUEUE_INBOX / f\"{run_id}.md\"\n73: \n74:     json_path.write_text(json.dumps(package, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n75: \n76:     allowed_files_md = \"\\n\".join(f\"- `{f}`\" for f in args.allowed_files) if args.allowed_files else \"- N/A\"\n77:     validation_commands_md = \"\\n\".join(f\"- `{c}`\" for c in args.validation_commands) if args.validation_commands else \"- N/A\"\n78: \n79:     md_content = (\n80:         \"# Handoff Package\\n\\n\"\n81:         f\"- run_id: `{run_id}`\\n\"\n82:         f\"- project_id: `{args.project_id}`\\n\"\n83:         f\"- target_agent: `{args.target_agent}`\\n\"\n84:         f\"- scenario: `{args.scenario}`\\n\"\n85:         f\"- risk_level: `{args.risk_level}`\\n\"\n86:         f\"- model: `{args.model}`\\n\\n\"\n87:         \"## Objective\\n\\n\"\n88:         f\"{args.objective}\\n\\n\"\n89:         \"## Handoff Body\\n\\n\"\n90:         f\"{args.handoff_body}\\n\\n\"\n91:         \"## Allowed Files\\n\\n\"\n92:         f\"{allowed_files_md}\\n\\n\"\n93:         \"## Validation Commands\\n\\n\"\n94:         f\"{validation_commands_md}\\n\\n\"\n95:         \"## Authorization\\n\\n\"\n96:         f\"- requires_authorization: `{requires_auth}`\\n\"\n97:         f\"- authorization_granted: `{auth_granted}`\\n\\n\"\n98:         \"## Status\\n\\ncreated\\n\"\n99:     )\n100:     md_path.write_text(md_content, encoding=\"utf-8\")\n101: \n102:     trace_path = run_dir / \"TRACE.md\"\n103:     summary_path = run_dir / \"RUN_SUMMARY.md\"\n104: \n105:     auth_status = \"granted\" if auth_granted else (\"pending\" if requires_auth else \"not_required\")\n106: \n107:     trace_path.write_text(\n108:         f\"# TRACE — {run_id}\\n\\n\"\n109:         f\"## Inicio — create_and_dispatch_opencode_handoff\\n\\n\"\n110:         f\"- run_id: {run_id}\\n\"\n111:         f\"- timestamp: {package['timestamp']}\\n\"\n112:         f\"- status: created\\n\"\n113:         f\"- authorization: {auth_status}\\n\",\n114:         encoding=\"utf-8\",\n115:     )\n116: \n117:     summary_path.write_text(\n118:         f\"# RUN_SUMMARY — {run_id}\\n\\n\"\n119:         f\"- status: created\\n\"\n120:         f\"- project_id: {args.project_id}\\n\"\n121:         f\"- target_agent: {args.target_agent}\\n\"\n122:         f\"- model: {args.model}\\n\"\n123:         f\"- authorization: {auth_status}\\n\",\n124:         encoding=\"utf-8\",\n125:     )\n126: \n127:     background_meta_path = None\n128: \n129:     if requires_auth and not auth_granted:\n130:         status = \"waiting_authorization\"\n131:     else:\n132:         status = \"dispatched\"\n133:         background_dir = run_dir / \"background\"\n134:         background_dir.mkdir(parents=True, exist_ok=True)\n135: \n136:         timestamp_str = datetime.datetime.now().isoformat(timespec=\"seconds\").replace(\":\", \"-\")\n137:         stdout_path = background_dir / f\"{timestamp_str}_opencode_async_stdout.log\"\n138:         stderr_path = background_dir / f\"{timestamp_str}_opencode_async_stderr.log\"\n139:         background_meta_path = background_dir / f\"{timestamp_str}_opencode_async_meta.json\"\n140: \n141:         env = os.environ.copy()\n142:         env.setdefault(\"PYTHONUTF8\", \"1\")\n143:         env.setdefault(\"PYTHONIOENCODING\", \"utf-8\")\n144: \n145:         command = [\n146:             sys.executable,\n147:             str(ROOT / \"scripts\" / \"run_opencode_from_handoff.py\"),\n148:             \"--run-id\",\n149:             run_id,\n150:             \"--agent\",\n151:             args.target_agent,\n152:             \"--model\",\n153:             args.model,\n154:             \"--prompt\",\n155:             f\"Lee el handoff {run_id} y actúa según el objetivo: {args.objective}\",\n156:         ]\n157: \n158:         stdout_file = stdout_path.open(\"w\", encoding=\"utf-8\", errors=\"replace\")\n159:         stderr_file = stderr_path.open(\"w\", encoding=\"utf-8\", errors=\"replace\")\n160: \n161:         creationflags = 0\n162:         if os.name == \"nt\":\n163:             creationflags = subprocess.CREATE_NEW_PROCESS_GROUP\n164: \n165:         proc = subprocess.Popen(\n166:             command,\n167:             cwd=ROOT,\n168:             stdout=stdout_file,\n169:             stderr=stderr_file,\n170:             stdin=subprocess.DEVNULL,\n171:             env=env,\n172:             text=True,\n173:             creationflags=creationflags,\n174:         )\n175: \n176:         meta = {\n177:             \"ok\": True,\n178:             \"status\": \"started\",\n179:             \"run_id\": run_id,\n180:             \"pid\": proc.pid,\n181:             \"agent\": args.target_agent,\n182:             \"model\": args.model,\n183:             \"command\": command,\n184:             \"stdout_path\": str(stdout_path),\n185:             \"stderr_path\": str(stderr_path),\n186:             \"meta_path\": str(background_meta_path),\n187:             \"started_at\": datetime.datetime.now().isoformat(timespec=\"seconds\"),\n188:         }\n189:         background_meta_path.write_text(json.dumps(meta, ensure_ascii=True, indent=2), encoding=\"utf-8\")\n190: \n191:     result = {\n192:         \"ok\": True,\n193:         \"status\": status,\n194:         \"run_id\": run_id,\n195:         \"handoff_json_path\": str(json_path),\n196:         \"handoff_md_path\": str(md_path),\n197:         \"run_dir\": str(run_dir),\n198:         \"trace_path\": str(trace_path),\n199:         \"summary_path\": str(summary_path),\n200:         \"background_meta_path\": str(background_meta_path) if background_meta_path else None,\n201:         \"target_agent\": args.target_agent,\n202:         \"model\": args.model,\n203:         \"next_tool\": \"check_opencode_run_status\",\n204:         \"user_message\": f\"Handoff '{run_id}' creado. Estado: {status}.\",\n205:     }\n206: \n207:     print(json.dumps(result, ensure_ascii=True, indent=2))\n208: \n209: \n210: if __name__ == \"__main__\":\n211:     main()\n\n(End of file - total 211 lines)\n</content>","metadata":{"preview":"\"\"\"\ncreate_and_dispatch_opencode_handoff.py\n\nCrea un paquete de handoff completo, lo persiste en docs/agent_queue/inbox,\ninicializa TRACE.md y RUN_SUMMARY.md en docs/agent_runs/<run_id>,\ny despacha OpenCode en segundo plano si está autorizado.\n\nEste script no ejecuta comandos arbitrarios.\nSolo invoca scripts probados del orquestador.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport argparse\nimport datetime\nimport json\nimport os\nimport subprocess\nimport sys","truncated":false,"loaded":[]},"title":"scripts\\create_and_dispatch_opencode_handoff.py","time":{"start":1778273046965,"end":1778273046981}},"id"