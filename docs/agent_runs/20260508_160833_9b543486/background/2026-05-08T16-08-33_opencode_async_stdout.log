 \"type\": \"text\",\n66:                 \"text\": json.dumps(data, ensure_ascii=False, indent=2),\n67:             }\n68:         ],\n69:         \"isError\": bool(isinstance(data, dict) and data.get(\"ok\") is False),\n70:     }\n71: \n72: \n73: def handle_initialize(params: dict[str, Any] | None = None) -> dict[str, Any]:\n74:     return {\n75:         \"protocolVersion\": \"2024-11-05\",\n76:         \"capabilities\": {\n77:             \"tools\": {},\n78:         },\n79:         \"serverInfo\": SERVER_INFO,\n80:     }\n81: \n82: \n83: def handle_tools_list() -> dict[str, Any]:\n84:     return {\n85:         \"tools\": TOOL_SCHEMAS,\n86:     }\n87: \n88: \n89: def handle_tools_call(params: dict[str, Any] | None = None) -> dict[str, Any]:\n90:     params = params or {}\n91:     name = params.get(\"name\")\n92:     arguments = params.get(\"arguments\") or {}\n93: \n94:     if not name:\n95:         return as_tool_content({\n96:             \"ok\": False,\n97:             \"error\": \"Falta params.name.\",\n98:         })\n99: \n100:     result = call_tool(str(name), arguments)\n101:     return as_tool_content(result)\n102: \n103: \n104: def handle_request(message: dict[str, Any]) -> None:\n105:     message_id = message.get(\"id\")\n106:     method = message.get(\"method\")\n107:     params = message.get(\"params\") or {}\n108: \n109:     try:\n110:         if method == \"initialize\":\n111:             respond(message_id, handle_initialize(params))\n112:             return\n113: \n114:         if method == \"tools/list\":\n115:             respond(message_id, handle_tools_list())\n116:             return\n117: \n118:         if method == \"tools/call\":\n119:             respond(message_id, handle_tools_call(params))\n120:             return\n121: \n122:         if method == \"ping\":\n123:             respond(message_id, {})\n124:             return\n125: \n126:         if method and method.startswith(\"notifications/\"):\n127:             return\n128: \n129:   