 {\n46:                     \"type\": \"string\",\n47:                     \"description\": \"Volumen de información.\",\n48:                     \"enum\": [\"low\", \"medium\", \"high\"],\n49:                     \"default\": \"medium\",\n50:                 },\n51:                 \"user_premium\": {\n52:                     \"type\": \"boolean\",\n53:                     \"description\": \"Indica si el usuario pidió explícitamente premium.\",\n54:                     \"default\": False,\n55:                 },\n56:             },\n57:             \"additionalProperties\": False,\n58:         },\n59:     },\n60:     {\n61:         \"name\": \"build_handoff_package\",\n62:         \"description\": \"Crea un paquete de handoff con fuentes, alertas y lecciones incorporadas desde el preflight.\",\n63:         \"inputSchema\": {\n64:             \"type\": \"object\",\n65:             \"properties\": {\n66:                 \"project_id\": {\n67:                     \"type\": \"string\",\n68:                     \"default\": \"orchestrator\",\n69:                 },\n70:                 \"source_agent\": {\n71:                     \"type\": \"string\",\n72:                     \"default\": \"continue\",\n73:                 },\n74:                 \"target_agent\": {\n75:                     \"type\": \"string\",\n76:                     \"default\": \"context-validator\",\n77:                 },\n78:                 \"scenario\": {\n79:                     \"type\": \"string\",\n80:                     \"default\": \"context-validation\",\n81:                 },\n82:                 \"risk\": {\n83:                     \"type\": \"string\",\n84:                     \"enum\": [\"low\", \"medium\", \"high\", \"critical\"],\n85:                     \"default\": \"medium\",\n86:                 },\n87:                 \"volume\": {\n88:                     \"type\": \"string\",\n89:                     \"enum\": [\"low\", \"medium\", \"high\"],\n90:                     \"default\": \"high\",\n91:                 },\n92:                 \"objective\": {\n93:                     \"type\": \"string\",\n94:                     \"description\": \"Objetivo del handoff.\",\n95:                 },\n96:             },\n97:             \"required\": [\"objective\"],\n98:             \"additionalProperties\": False,\n99:         },\n100:     },\n101:     {\n102:         \"name\": \"run_diagnostic_flow\",\n103:         \"description\": \"Ejecuta el flujo diagnóstico semiautomático. Puede invocar OpenCode real si with_opencode=True.\",\n104:         \"inputSchema\": {\n105:             \"type\": \"object\",\n106:             \"properties\": {\n107:                 \"project_id\": {\n108:                     \"type\": \"string\",\n109:                     \"default\": \"orchestrator\",\n110:                 },\n111:                 \"scenario\": {\n112:                     \"type\": \"string\",\n113:                     \"default\": \"context-validation\",\n114:                 },\n115:                 \"risk\": {\n116:                     \"type\": \"string\",\n117:                     \"enum\": [\"low\", \"medium\", \"high\", \"critical\"],\n118:                     \"default\": \"medium\",\n119:                 },\n120:                 \"volume\": {\n121:                     \"type\": \"string\",\n122:                     \"enum\": [\"low\", \"medium\", \"high\"],\n123:                     \"default\": \"high\",\n124:                 },\n125:                 \"objective\": {\n126:                     \"type\": \"string\",\n127:                     \"default\": \"Flujo diagnóstico MCP v0.1.\",\n128:                 },\n129:                 \"with_opencode\": {\n130:                     \"type\": \"boolean\",\n131:                     \"description\": \"Invoca OpenCode real en modo diagnóstico controlado.\",\n132:                     \"default\": False,\n133:                 },\n134:             },\n135:             \"additionalProperties\": False,\n136:         },\n137:     },\n138:     {\n139:         \"name\": \"show_latest_run\",\n140:         \"description\": \"Muestra el último flujo o un run específico con RUN_SUMMARY y TRACE.\",\n141:         \"inputSchema\": {\n142:             \"type\": \"object\",\n143:             \"properties\": {\n144:                 \"run_id\": {\n145:                     \"type\": \"string\",\n146:                     \"description\": \"Run ID opcional. Si se omite, muestra el último run.\",\n147:                 },\n148:             },\n149:             \"additionalProperties\": False,\n150:         },\n151:     },\n152:     {\n153:         \"name\": \"run_opencode_from_handoff\",\n154:         \"description\": \"Invoca OpenCode real desde un handoff existente en modo diagnóstico controlado.\",\n155:         \"inputSchema\": {\n156:             \"type\": \"object\",\n157:             \"properties\": {\n158:                 \"run_id\": {\n159:                     \"type\": \"string\",\n160:                     \"description\": \"Run ID del handoff existente.\",\n161:                 },\n162:                 \"agent\": {\n163:                     \"type\": \"string\",\n164:                     \"default\": \"context-validator\",\n165:                 },\n166:                 \"model\": {\n167:                     \"type\": \"string\",\n168:                     \"default\": \"opencode-go/qwen3.6-plus\",\n169:                 },\n170:                 \"prompt\": {\n171:                     \"type\": \"string\",\n172:                     \"description\": \"Prompt diagnóstico para OpenCode. No debe pedir edición ni ejecución de comandos.\",\n173:                 },\n174:             },\n175:             \"required\": [\"run_id\"],\n176:             \"additionalProperties\": False,\n177:         },\n178:     },\n179:     {\n180:         \"name\": \"start_opencode_from_handoff_async\",\n181:         \"description\": \"Lanza OpenCode real desde un handoff existente en segundo plano y devuelve inmediatamente estado started.\",\n182:         \"inputSchema\": {\n183:             \"type\": \"object\",\n184:             \"properties\": {\n185:                 \"run_id\": {\n186:                     \"type\": \"string\",\n187:                     \"description\": \"Run ID del handoff existente.\"\n188:                 },\n189:                 \"agent\": {\n190:                     \"type\": \"string\",\n191:                     \"default\": \"context-validator\"\n192:                 },\n193:                 \"model\": {\n194:                     \"type\": \"string\",\n195:                     \"default\": \"opencode-go/qwen3.6-plus\"\n196:                 },\n197:                 \"prompt\": {\n198:                     \"type\": \"string\",\n199:                     \"description\": \"Prompt diagnóstico para OpenCode. No debe pedir edición ni ejecución de comandos.\"\n200:                 }\n201:             },\n202:             \"required\": [\"run_id\"],\n203:             \"additionalProperties\": False\n204:         }\n205:     }\n206: ,\n207:     {\n208:         \"name\": \"create_and_dispatch_opencode_handoff\",\n209:         \"description\": \"Crea un paquete de handoff, lo persiste en docs/agent_queue/inbox, inicializa TRACE.md y RUN_SUMMARY.md, y despacha OpenCode en segundo plano si está autorizado.\",\n210:         \"inputSchema\": {\n211:             \"type\": \"object\",\n212:             \"properties\": {\n213:                 \"project_id\": {\n214:                     \"type\": \"string\",\n215:                     \"default\": \"orchestrator\",\n216:                 },\n217:                 \"objective\": {\n218:                     \"type\": \"string\",\n219:                     \"description\": \"Objetivo del handoff.\",\n220:                 },\n221:                 \"handoff_body\": {\n222:                     \"type\": \"string\",\n223:                     \"description\": \"Cuerpo del handoff con detalles.\",\n224:                     \"default\": \"\",\n225:                 },\n226:                 \"target_agent\": {\n227:                     \"type\": \"string\",\n228:                     \"description\": \"Agente destino, ej: builder, debugger, context-validator.\",\n229:                 },\n230:                 \"model\": {\n231:                     \"type\": \"string\",\n232:                     \"description\": \"Modelo sugerido, ej: opencode-go/kimi-k2.6\",\n233:                 },\n234:                 \"risk_level\": {\n235:                     \"type\": \"string\",\n236:                     \"enum\": [\"low\", \"medium\", \"high\", \"critical\"],\n237:                     \"default\": \"medium\",\n238:                 },\n239:                 \"scenario\": {\n240:                     \"type\": \"string\",\n241:                     \"default\": \"implementation\",\n242:                 },\n243:                 \"allowed_files\": {\n244:                     \"type\": \"array\",\n245:                     \"items\": {\"type\": \"string\"},\n246:                     \"description\": \"Archivos permitidos para el alcance.\",\n247:                     \"default\": [],\n248:                 },\n249:                 \"validation_commands\": {\n250:                     \"type\": \"array\",\n251:                     \"items\": {\"type\": \"string\"},\n252:                     \"description\": \"Comandos de validación sugeridos.\",\n253:                     \"default\": [],\n254:                 },\n255:                 \"requires_authorization\": {\n256:                     \"type\": \"boolean\",\n257:                     \"description\": \"Si requiere autorización humana antes de despachar.\",\n258:                     \"default\": False,\n259:                 },\n260:                 \"authorization_granted\": {\n261:                     \"type\": \"boolean\",\n262:                     \"description\": \"Si la autorización humana ya fue concedida.\",\n263:                     \"default\": False,\n264:                 },\n265:             },\n266:             \"required\": [\"project_id\", \"objective\", \"target_agent\", \"model\", \"risk_level\", \"scenario\"],\n267:             \"additionalProperties\": False,\n268:         },\n269:     },\n270:     {\n271:         \"name\": \"get_run_status\",\n272:         \"description\": \"Devuelve un resumen compacto de un run, incluyendo si OpenCode registró salida en agent_outputs, raw_outputs, TRACE.md y RUN_SUMMARY.md.\",\n273:         \"inputSchema\": {\n274:             \"type\": \"object\",\n275:             \"properties\": {\n276:                 \"run_id\": {\n277:                     \"type\": \"string\",\n278:                     \"description\": \"Run ID opcional. Si se omite, usa el run más reciente.\"\n279:                 }\n280:             },\n281:             \"additionalProperties\": False\n282:         }\n283:     },\n284:     {\n285:         \"name\": \"check_opencode_run_status\",\n286:         \"description\": \"Verifica de forma compacta si un run ya tiene salida de OpenCode registrada en agent_outputs, raw_outputs, TRACE.md y RUN_SUMMARY.md.\",\n287:         \"inputSchema\": {\n288:             \"type\": \"object\",\n289:             \"properties\": {\n290:                 \"run_id\": {\n291:                     \"type\": \"string\",\n292:                     \"description\": \"Run ID que se desea verificar.\"\n293:                 }\n294:             },\n295:             \"required\": [\"run_id\"],\n296:             \"additionalProperties\": False\n297:         }\n298:     },\n299:     {\n300:         \"name\": \"verify_master_files\",\n301:         \"description\": \"Verifica físicamente la existencia e integridad SHA-256 de los archivos maestros críticos del orquestador.\",\n302:         \"inputSchema\": {\n303:             \"type\": \"object\",\n304:             \"properties\": {\n305:                 \"paths\": {\n306:                     \"type\": \"array\",\n307:                     \"items\": {\"type\": \"string\"},\n308:                     \"description\": \"Rutas relativas a ROOT para verificar. Si se omite, usa la lista maestra completa.\",\n309:                     \"default\": [],\n310:                 }\n311:             },\n312:             \"additionalProperties\": False,\n313:         },\n314:     }\n315: ]\n316: \n\n(End of file - total 316 lines)\n</content>","metadata":{"preview":"﻿\"\"\"\nschemas.py\n\nEsquemas de herramientas MCP del orquestador local.\n\nFase v0.1:\n- Solo diagnóstico.\n- Sin comandos arbitrarios.\n- Sin edición de código.\n- Sin secrets.\n- Sin deployment.\n- Sin migraciones.\n\"\"\"\n\nfrom __future__ import annotations\n\n\nTOOL_SCHEMAS = [\n    {\n        \"name\": \"orchestrator_preflight\",","truncated":false,"loaded":[]},"title":"mcp_server\\schemas.py","time":{"start":1778274531681,"end":1778274531696}},"id":"prt_e096bf7ef0015wz3icIqEvnJIE","sessionID":"ses_1f69442e4ffekofdCA917V2jtY","messageID":"msg_e096bbdcd001kH0znvpE3tpEMr"}}
{"type":"tool_use","timestamp":1778274532043,"sessionID":"ses_1f69442e4ffekofdCA917V2jtY","part":{"type":"tool","tool":"read","callID":"read:3","state":{"status":"completed","input":{"filePath":"C:\\Agente\\scripts\\orchestrator_preflight.py"},"output":"<path>C:\\Agente\\scripts\\orchestrator_preflight.py</path>\n<type>file</type>\n<content>\n1: ﻿\"\"\"\n2: orchestrator_preflight.py\n3: \n4: Preflight semiautomático del orquestador local.\n5: \n6: Objetivo:\n7: - Identificar si existe contexto mínimo para iniciar una tarea.\n8: - Verificar archivos transversales obligatorios.\n9: - Reportar fuentes, alertas y lecciones disponibles.\n10: - Operar en modo diagnóstico, no ejecución.\n11: \n12: Este script no modifica archivos.\n13: \"\"\"\n14: \n15: from __future__ import annotations\n16: \n17: from pathlib import Path\n18: import json\n19: import datetime\n20: import re\n21: \n22: \n23: ROOT = Path(__file__).resolve().parents[1]\n24: \n25: REQUIRED_FILES = [\n26:     \"TARGET_PROJECT_CONTEXT_CONTRACT.md\",\n27:     \"PROJECT_REGISTRY.md\",\n28:     \"AGENT_RULES.md\",\n29:     \"MODEL_ROUTING.md\",\n30:     \"AGENT_ORCHESTRATION.md\",\n31:     \"CONTINUE_USAGE_PROTOCOL.md\",\n32:     \"REPLIT_HANDOFF.md\",\n33:     \"docs/protocols/PROJECT_ENABLEMENT_PROTOCOL.md\",\n34:     \"docs/protocols/CONTEXT_SYNC_PROTOCOL.md\",\n35:     \"docs/protocols/DOCUMENTATION_CODE_ALIGNMENT_PROTOCOL.md\",\n36:     \"docs/protocols/AGENT_AUTOMATION_PROTOCOL.md\",\n37:     \"docs/alerts/GLOBAL_CRITICAL_ALERTS.md\",\n38:     \"docs/lessons/GLOBAL_LESSONS_LEARNED.md\",\n39: ]\n40: \n41: ALERTS_FILE = ROOT / \"docs\" / \"alerts\" / \"GLOBAL_CRITICAL_ALERTS.md\"\n42: LESSONS_FILE = ROOT / \"docs\" / \"lessons\" / \"GLOBAL_LESSONS_LEARNED.md\"\n43: \n44: \n45: def extract_ids(path: Path, pattern: str) -> list[str]:\n46:     if not path.exists():\n47:         return []\n48:     text = path.read_text(encoding=\"utf-8\", errors=\"ignore\")\n49:     return sorted(set(re.findall(pattern, text)))\n50: \n51: \n52: def check_required_files() -> list[dict]:\n53:     results = []\n54:     for rel in REQUIRED_FILES:\n55:         path = ROOT / rel\n56:         results.append({\n57:             \"path\": rel,\n58:             \"exists\": path.exists(),\n59:             \"type\": \"file\" if path.is_file() else \"missing\",\n60:         })\n61:     return results\n62: \n63: \n64: def main() -> None:\n65:     now = datetime.datetime.now().isoformat(timespec=\"seconds\")\n66:     checks = check_required_files()\n67:     missing = [item[\"path\"] for item in checks if not item[\"exists\"]]\n68:     context_sources = [item[\"path\"] for item in checks if item[\"exists\"]]\n69: \n70:     alerts_checked = extract_ids(ALERTS_FILE, r\"ALERT-GLOBAL-\\d+\")\n71:     lessons_checked = extract_ids(LESSONS_FILE, r\"LESSON-GLOBAL-\\d+\")\n72: \n73:     result = {\n74:         \"timestamp\": now,\n75:         \"root\": str(ROOT),\n76:         \"mode\": \"diagnostic\",\n77:         \"context_sources\": context_sources,\n78:         \"alerts_checked\": alerts_checked,\n79:         \"lessons_checked\": lessons_checked,\n80:         \"required_files\": checks,\n81:         \"missing_files\": missing,\n82:         \"status\": \"ok\" if not missing else \"context_incomplete\",\n83:         \"next_action\": (\n84:             \"Contexto transversal mínimo disponible.\"\n85:             if not missing\n86:             else \"Faltan fuentes obligatorias. Operar en modo diagnóstico.\"\n87:         ),\n88:     }\n89: \n90:     print(json.dumps(result, ensure_ascii=True, indent=2))\n91: \n92: \n93: if __name__ == \"__main__\":\n94:     main()\n95: \n\n(End of file - total 95 lines)\n</content>","metadata":{"preview":"﻿\"\"\"\norchestrator_preflight.py\n\nPreflight semiautomático del orquestador local.\n\nObjetivo:\n- Identificar si existe contexto mínimo para iniciar una tarea.\n- Verificar archivos transversales obligatorios.\n- Reportar fuentes, alertas y lecciones disponibles.\n- Operar en modo diagnóstico, no ejecución.\n\nEste script no modifica archivos.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport json\nimport datetime\nimport re","truncated":false,"loaded":[]},"title":"scripts\\orchestrator_preflight.py","time":{"start":1778274532032,"end":1778274532042}},"id":"prt_e096bf9630012ZXRjbveTPkjOV","sessionID":"ses_1f69442e4ffekofdCA917V2jtY","messageID":"msg_e096bbdcd001kH0znvpE3tpEMr"}}
{"type":"tool_use","timestamp":1778274532394,"sessionID":"ses_1f69442e4ffekofdCA917V2jtY","part":{"type":"tool","tool":"read","callID":"read:4","state":{"status":"completed","input":{"filePath":"C:\\Agente\\scripts\\verify_master_files.py"},"output":"<path>C:\\Agente\\scripts\\verify_master_files.py</path>\n<type>file</type>\n<content>\n1: \"\"\"\n2: verify_master_files.py\n3: \n4: Verifica físicamente la existencia e integridad SHA-256 de los archivos maestros\n5: críticos del orquestador, reduciendo el riesgo de diagnósticos falsos por\n6: visibilidad parcial del IDE.\n7: \"\"\"\n8: \n9: from __future__ import annotations\n10: \n11: import argparse\n12: import hashlib\n13: import json\n14: import os\n15: import sys\n16: from datetime import datetime, timezone\n17: from pathlib import Path\n18: \n19: \n20: def get_root() -> Path:\n21:     return Path(__file__).resolve().parents[1]\n22: \n23: \n24: MASTER_FILES = [\n25:     \"TARGET_PROJECT_CONTEXT_CONTRACT.md\",\n26:     \"PROJECT_REGISTRY.md\",\n27:     \"AGENT_RULES.md\",\n28:     \"MODEL_ROUTING.md\",\n29:     \"AGENT_ORCHESTRATION.md\",\n30:     \"docs/AGENT_ORCHESTRATION.md\",\n31:     \"CONTINUE_USAGE_PROTOCOL.md\",\n32:     \"REPLIT_HANDOFF.md\",\n33:     \"docs/protocols/PROJECT_ENABLEMENT_PROTOCOL.md\",\n34:     \"docs/protocols/CONTEXT_SYNC_PROTOCOL.md\",\n35:     \"docs/protocols/DOCUMENTATION_CODE_ALIGNMENT_PROTOCOL.md\",\n36:     \"docs/protocols/AGENT_AUTOMATION_PROTOCOL.md\",\n37:     \"docs/protocols/MCP_CONTINUE_INTEGRATION_PROTOCOL.md\",\n38:     \"docs/alerts/GLOBAL_CRITICAL_ALERTS.md\",\n39:     \"docs/lessons/GLOBAL_LESSONS_LEARNED.md\",\n40: ]\n41: \n42: DUPLICATE_CANDIDATE_PAIRS = [\n43:     (\"AGENT_ORCHESTRATION.md\", \"docs/AGENT_ORCHESTRATION.md\"),\n44: ]\n45: \n46: \n47: def sha256_file(path: Path) -> str:\n48:     h = hashlib.sha256()\n49:     with path.open(\"rb\") as f:\n50:         for chunk in iter(lambda: f.read(8192), b\"\"):\n51:             h.update(chunk)\n52:     return h.hexdigest()\n53: \n54: \n55: def verify_file(root: Path, rel_path: str) -> dict[str, object]:\n56:     result: dict[str, object] = {\n57:         \"path\": rel_path,\n58:         \"absolute_path\": None,\n59:         \"exists\": False,\n60:         \"type\": \"missing\",\n61:         \"size_bytes\": None,\n62:         \"sha256\": None,\n63:         \"modified_time\": None,\n64:         \"status\": \"missing\",\n65:         \"error\": None,\n66:     }\n67: \n68:     try:\n69:         full = root / rel_path\n70:         # Bloquear rutas fuera de ROOT usando relative_to, no startswith\n71:         try:\n72:             full.relative_to(root)\n73:         except ValueError:\n74:             result[\"error\"] = \"Ruta fuera de ROOT.\"\n75:             result[\"status\"] = \"error\"\n76:             return result\n77: \n78:         result[\"absolute_path\"] = str(full.resolve())\n79: \n80:         if not full.exists():\n81:             result[\"exists\"] = False\n82:             result[\"type\"] = \"missing\"\n83:             result[\"status\"] = \"missing\"\n84:             return result\n85: \n86:         result[\"exists\"] = True\n87: \n88:         if full.is_file():\n89:             result[\"type\"] = \"file\"\n90:             result[\"size_bytes\"] = full.stat().st_size\n91:             result[\"sha256\"] = sha256_file(full)\n92:             mtime = full.stat().st_mtime\n93:             result[\"modified_time\"] = datetime.fromtimestamp(mtime, tz=timezone.utc).isoformat()\n94:             result[\"status\"] = \"ok\"\n95:         elif full.is_dir():\n96:             result[\"type\"] = \"directory\"\n97:             result[\"status\"] = \"ok\"\n98:         else:\n99:             result[\"type\"] = \"other\"\n100:             result[\"status\"] = \"ok\"\n101: \n102:     except Exception as exc:\n103:         result[\"error\"] = str(exc)\n104:         result[\"status\"] = \"error\"\n105: \n106:     return result\n107: \n108: \n109: def find_duplicate_candidates(root: Path, files: list[dict[str, object]]) -> list[dict[str, object]]:\n110:     candidates = []\n111:     path_map = {f[\"path\"]: f for f in files}\n112: \n113:     for a, b in DUPLICATE_CANDIDATE_PAIRS:\n114:         fa = path_map.get(a)\n115:         fb = path_map.get(b)\n116:         if fa and fb and fa.get(\"exists\") and fb.get(\"exists\"):\n117:             candidates.append({\n118:                 \"pair\": [a, b],\n119:                 \"sha256_a\": fa.get(\"sha256\"),\n120:                 \"sha256_b\": fb.get(\"sha256\"),\n121:                 \"same_hash\": fa.get(\"sha256\") == fb.get(\"sha256\"),\n122:             })\n123: \n124:     return candidates\n125: \n126: \n127: def verify(paths: list[str] | None = None) -> dict[str, object]:\n128:     root = get_root()\n129:     target_paths = paths if paths else MASTER_FILES\n130: \n131:     files = []\n132:     for rel in target_paths:\n133:         files.append(verify_file(root, rel))\n134: \n135:     existing = [f for f in files if f.get(\"exists\")]\n136:     missing = [f for f in files if not f.get(\"exists\")]\n137:     errors = [f for f in files if f.get(\"status\") == \"error\"]\n138: \n139:     duplicate_candidates = find_duplicate_candidates(root, files)\n140: \n141:     summary = {\n142:         \"total_checked\": len(files),\n143:         \"total_existing\": len(existing),\n144:         \"total_missing\": len(missing),\n145:         \"total_errors\": len(errors),\n146:         \"missing_files\": [f[\"path\"] for f in missing],\n147:         \"duplicate_candidates\": duplicate_candidates,\n148:         \"all_ok\": len(missing) == 0 and len(errors) == 0,\n149:         \"generated_at\": datetime.now(timezone.utc).isoformat(),\n150:         \"root\": str(root),\n151:     }\n152: \n153:     return {\n154:         \"ok\": True,\n155:         \"files\": files,\n156:         \"summary\": summary,\n157:     }\n158: \n159: \n160: def main() -> None:\n161:     parser = argparse.ArgumentParser(description=\"Verifica archivos maestros del orquestador.\")\n162:     parser.add_argument(\n163:         \"--paths\",\n164:         nargs=\"+\",\n165:         help=\"Rutas relativas a ROOT para verificar (por defecto usa la lista maestra).\",\n166:     )\n167:     args = parser.parse_args()\n168: \n169:     result = verify(args.paths)\n170:     print(json.dumps(result, ensure_ascii=False, indent=2))\n171: \n172: \n173: if __name__ == \"__main__\":\n174:     main()\n\n(End of file - total 174 lines)\n</content>","metadata":{"preview":"\"\"\"\nverify_master_files.py\n\nVerifica físicamente la existencia e integridad SHA-256 de los archivos maestros\ncríticos del orquestador, reduciendo el riesgo de diagnósticos falsos por\nvisibilidad parcial del IDE.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\n\ndef get_root() -> Path:","truncated":false,"loaded":[]},"title":"scripts\\verify_master_files.py","time":{"start":1778274532381,"end":1778274532393}},"id":"prt_e096bfac1001Pi6dlhbH14nFuI","sessionID":"ses_1f69442e4ffekofdCA917V2jtY","messageID":"msg_e096bbdcd001kH0znvpE3tpEMr"}}
{"type":"tool_use","timestamp":1778274532413,"sessionID":"ses_1f69442e4ffekofdCA917V2jtY","part":{"type":"tool","tool":"read","callID":"read:5","state":{"status":"completed","input":{"filePath":"C:\\Agente\\scripts\\get_run_status.py"},"output":"<path>C:\\Agente\\scripts\\get_run_status.py</path>\n<type>file</type>\n<content>\n1: ﻿\"\"\"\n2: get_run_status.py\n3: \n4: Devuelve un resumen compacto y JSON-friendly de un run del orquestador.\n5: \n6: Objetivo:\n7: - Evitar que Continue use terminal para leer archivos manualmente.\n8: - Evitar respuestas extensas de show_latest_run.\n9: - Confirmar si existe salida de OpenCode en agent_outputs/raw_outputs/TRACE/RUN_SUMMARY.\n10: \"\"\"\n11: \n12: from __future__ import annotations\n13: \n14: from pathlib import Path\n15: import argparse\n16: import json\n17: import re\n18: \n19: \n20: ROOT = Path(__file__).resolve().parents[1]\n21: RUNS = ROOT / \"docs\" / \"agent_runs\"\n22: INBOX = ROOT / \"docs\" / \"agent_queue\" / \"inbox\"\n23: \n24: \n25: def latest_run_id() -> str | None:\n26:     runs = sorted([p for p in RUNS.iterdir() if p.is_dir()], key=lambda p: p.stat().st_mtime, reverse=True) if RUNS.exists() else []\n27:     return runs[0].name if runs else None\n28: \n29: \n30: def read_text(path: Path) -> str:\n31:     if not path.exists():\n32:         return \"\"\n33:     return path.read_text(encoding=\"utf-8\", errors=\"replace\")\n34: \n35: \n36: def json_files(path: Path) -> list[str]:\n37:     if not path.exists():\n38:         return []\n39:     return sorted([p.name for p in path.glob(\"*.json\")])\n40: \n41: \n42: def extract_agents_from_trace(trace: str) -> list[str]:\n43:     agents = []\n44:     for match in re.finditer(r\"^##\\s+.+?—\\s+(.+?)\\s*$\", trace, flags=re.MULTILINE):\n45:         agents.append(match.group(1).strip())\n46:     return agents\n47: \n48: \n49: def main() -> None:\n50:     parser = argparse.ArgumentParser()\n51:     parser.add_argument(\"--run-id\", default=None)\n52:     args = parser.parse_args()\n53: \n54:     run_id = args.run_id or latest_run_id()\n55: \n56:     if not run_id:\n57:         print(json.dumps({\n58:             \"ok\": False,\n59:             \"status\": \"not_found\",\n60:             \"error\": \"No hay runs disponibles.\",\n61:         }, ensure_ascii=True, indent=2))\n62:         return\n63: \n64:     run_dir = RUNS / run_id\n65:     inbox_json = INBOX / f\"{run_id}.json\"\n66:     inbox_md = INBOX / f\"{run_id}.md\"\n67:     summary_path = run_dir / \"RUN_SUMMARY.md\"\n68:     trace_path = run_dir / \"TRACE.md\"\n69:     agent_outputs_dir = run_dir / \"agent_outputs\"\n70:     raw_outputs_dir = run_dir / \"raw_outputs\"\n71:     background_dir = run_dir / \"background\"\n72: \n73:     trace = read_text(trace_path)\n74:     summary = read_text(summary_path)\n75: \n76:     agent_outputs = json_files(agent_outputs_dir)\n77:     raw_outputs = json_files(raw_outputs_dir)\n78:     background_meta = sorted([p.name for p in background_dir.glob(\"*_meta.json\")]) if background_dir.exists() else []\n79:     background_stdout = sorted([p.name for p in background_dir.glob(\"*_stdout.log\")]) if background_dir.exists() else []\n80:     background_stderr = sorted([p.name for p in background_dir.glob(\"*_stderr.log\")]) if background_dir.exists() else []\n81: \n82:     agents = extract_agents_from_trace(trace)\n83: \n84:     opencode_outputs = [name for name in agent_outputs if \"_opencode\" in name]\n85:     opencode_raw_outputs = [name for name in raw_outputs if \"_opencode_raw\" in name]\n86: \n87:     result = {\n88:         \"ok\": run_dir.exists(),\n89:         \"status\": \"ok\" if run_dir.exists() else \"not_found\",\n90:         \"run_id\": run_id,\n91:         \"paths\": {\n92:             \"run_dir\": str(run_dir),\n93:             \"handoff_json_exists\": inbox_json.exists(),\n94:             \"handoff_md_exists\": inbox_md.exists(),\n95:             \"run_summary_exists\": summary_path.exists(),\n96:             \"trace_exists\": trace_path.exists(),\n97:             \"agent_outputs_dir_exists\": agent_outputs_dir.exists(),\n98:             \"raw_outputs_dir_exists\": raw_outputs_dir.exists(),\n99:             \"background_dir_exists\": background_dir.exists(),\n100:         },\n101:         \"counts\": {\n102:             \"agent_outputs\": len(agent_outputs),\n103:             \"raw_outputs\": len(raw_outputs),\n104:             \"opencode_outputs\": len(opencode_outputs),\n105:             \"opencode_raw_outputs\": len(opencode_raw_outputs),\n106:             \"background_meta\": len(background_meta),\n107:             \"background_stdout\": len(background_stdout),\n108:             \"background_stderr\": len(background_stderr),\n109:         },\n110:         \"agents_in_trace\": agents,\n111:         \"has_orchestrator_diagnostic\": \"orchestrator-diagnostic-flow\" in agents,\n112:         \"has_opencode_context_validator\": \"context-validator\" in agents and len(opencode_outputs) > 0,\n113:         \"opencode_registered\": len(opencode_outputs) > 0 and len(opencode_raw_outputs) > 0,\n114:         \"files\": {\n115:             \"agent_outputs\": agent_outputs,\n116:             \"raw_outputs\": raw_outputs,\n117:             \"background_meta\": background_meta,\n118:             \"background_stdout\": background_stdout,\n119:             \"background_stderr\": background_stderr,\n120:         },\n121:         \"summary_preview\": summary[:800].replace(\"\\n\", \" \"),\n122:         \"trace_preview\": trace[:800].replace(\"\\n\", \" \"),\n123:     }\n124: \n125:     print(json.dumps(result, ensure_ascii=True, indent=2))\n126: \n127: \n128: if __name__ == \"__main__\":\n129:     main()\n\n(End of file - total 129 lines)\n</content>","metadata":{"preview":"﻿\"\"\"\nget_run_status.py\n\nDevuelve un resumen compacto y JSON-friendly de un run del orquestador.\n\nObjetivo:\n- Evitar que Continue use terminal para leer archivos manualmente.\n- Evitar respuestas extensas de show_latest_run.\n- Confirmar si existe salida de OpenCode en agent_outputs/raw_outputs/TRACE/RUN_SUMMARY.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nimport argparse\nimport json\nimport re\n\n\nROOT = Path(__file__).resolve().parents[1]","truncated":false,"loaded":[]},"title":"scripts\\get_run_status.py","time":{"start":1778274532403,"end":1778274532412}},"id":"prt_e096bfc1f0017Q51gZl3oWyqX0","sessionID":"ses_1f69442e4ffekofdCA917V2jtY","messageID":"msg_e096bbdcd001kH0znvpE3tpEMr"}}
